# Imagem de compilacao do binario Linux do Exectron.
#
# O app precisa de cgo com GTK3, WebKit2GTK e libayatana-appindicator, que nao
# existem numa maquina Windows. Por isso `scripts/package.sh linux` compila aqui
# dentro. O Docker e ferramenta de build: nao entra no instalador nem no app.
#
# Base Ubuntu 22.04 (glibc 2.35) de proposito: um binario ligado a uma glibc mais
# nova nao roda em distribuicoes LTS mais antigas, e o caminho contrario funciona.
FROM ubuntu:22.04

ARG GO_VERSION=1.23.6
ARG NODE_MAJOR=20
ARG WAILS_VERSION=v2.12.0

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/go/bin:/go/bin:$PATH \
    GOPATH=/go \
    CGO_ENABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config ca-certificates curl git gzip tar xz-utils \
      libgtk-3-dev libwebkit2gtk-4.0-dev libayatana-appindicator3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
      | tar -C /usr/local -xzf -

RUN curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN go install "github.com/wailsapp/wails/v2/cmd/wails@${WAILS_VERSION}"

# O cache de modulos vem de um volume nomeado, entao um rebuild nao rebaixa tudo.
VOLUME /go/pkg/mod
WORKDIR /work
